00000352 <_Z9uart_initm>:
void uart_print_binary(uint8_t value) {
	for (uint8_t i = 8; i > 0; i--) {
		uint8_t bit = (value >> (i - 1)) & 0x01;
		uart_transmit(bit ? '1' : '0');
	}
}
